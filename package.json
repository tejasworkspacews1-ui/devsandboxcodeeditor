{
  "name": "devsandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Professional browser-based developer sandbox",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "lint": "eslint apps/web/src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --workspace=apps/web"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "eslint": "^8.56.0"
  }
}
